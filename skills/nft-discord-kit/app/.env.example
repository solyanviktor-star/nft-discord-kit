# Copy to .env and fill in. Never commit .env, never paste these values into a chat.

# Developer Portal > your application > Bot > Reset Token
DISCORD_TOKEN=

# Optional: Developer Portal > OAuth2 > Client Secret. Turns on "Verify with Discord" on the website
# (needed for auto-join and for website raffles).
DISCORD_CLIENT_SECRET=

# Optional: 32 or more random characters (shorter is refused). Left empty, one is generated into
# data/session_secret; on a host without a persistent disk set it here so it survives deploys.
SESSION_SECRET=

# Where the website is served. Overrides project.public_url in config.toml.
PUBLIC_URL=https://verify.example.com

# RPC URLs per chain, named by `rpc_env` in config.toml. Several URLs = fallback order.
# Keyed URLs (Alchemy, Infura, QuickNode...) are fine here; they are never logged.
RPC_ETHEREUM=https://ethereum-rpc.publicnode.com
# RPC_BASE=https://mainnet.base.org
# RPC_SOLANA=https://your-das-capable-solana-rpc.example.com
